# Copy this file to `.env` and fill in real values. Never commit `.env`.

# --- Core ---
SECRET_KEY=change-me-to-a-long-random-string
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,codesecureacademy.com,www.codesecureacademy.com
CSRF_TRUSTED_ORIGINS=https://codesecureacademy.com,https://www.codesecureacademy.com

# --- Database (Supabase Postgres connection string, "Session pooler" URI) ---
# Format: postgres://USER:PASSWORD@HOST:PORT/DBNAME
DATABASE_URL=
DB_SSL_REQUIRE=True

# --- Email (Brevo SMTP relay) ---
# Once you have a real domain:
#   1. Brevo dashboard -> Settings -> Senders, Domains & Dedicated IPs -> add
#      + verify your domain (SPF/DKIM records) so mail doesn't land in spam.
#   2. Brevo dashboard -> Settings -> SMTP & API -> "SMTP" tab (NOT the "API
#      Keys" tab — that's a different key, for their REST API, not this).
#      EMAIL_HOST_USER = the login shown there (your Brevo account email).
#      EMAIL_HOST_PASSWORD = the "SMTP key" shown there (click to reveal/generate).
#   3. DEFAULT_FROM_EMAIL below must be an address on the verified domain from step 1.
#   4. Flip EMAIL_BACKEND to the smtp line below (it's on console/no-op until then).
# Zoho Mail or Google Workspace SMTP work too if you'd rather use those — just
# swap the host/port/credentials, everything else in the app stays the same.
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp-relay.brevo.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=Code Secure Academy <info@codesecureacademy.com>

# --- Cloudinary (free plan) ---
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# --- Paystack ---
PAYSTACK_PUBLIC_KEY=pk_test_xxxxxxxx
PAYSTACK_SECRET_KEY=sk_test_xxxxxxxx

# --- Google OAuth (for "Sign in with Google") ---
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# --- Seat-hold behaviour ---
SEAT_HOLD_MINUTES=5
SEAT_HOLD_GRACE_MINUTES=3
# Long random token — the external pinger (cron-job.org/UptimeRobot) must send this
# to authenticate calls to /internal/release-expired-holds/
INTERNAL_TASK_TOKEN=change-me-to-a-long-random-string

# --- Marketplace ---
MARKETPLACE_CSA_SPLIT_PERCENT=10

# --- Courses (tutor payouts) ---
COURSE_TUTOR_PAYOUT_PERCENT=90
# Hours a payout waits before /pay/internal/release-pending-payouts/ auto-releases it —
# same external-pinger pattern as INTERNAL_TASK_TOKEN above
PAYOUT_HOLD_HOURS=48

# --- Social ---
INSTAGRAM_URL=https://instagram.com/codesecureacademy
FACEBOOK_URL=https://facebook.com/codesecureacademy
WHATSAPP_CONTACT_NUMBER=2340000000000
