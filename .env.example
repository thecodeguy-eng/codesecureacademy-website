# Copy this file to `.env` and fill in real values. Never commit `.env`.

# --- Core ---
SECRET_KEY=change-me-to-a-long-random-string
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,codesecureacademy.com,www.codesecureacademy.com
CSRF_TRUSTED_ORIGINS=https://codesecureacademy.com,https://www.codesecureacademy.com

# --- Database (Supabase Postgres connection string, "Session pooler" URI) ---
# Format: postgres://USER:PASSWORD@HOST:PORT/DBNAME
DATABASE_URL=
DB_SSL_REQUIRE=True

# --- Email (Brevo, sent over their HTTPS REST API — see apps/core/email_backend.py) ---
# Switched off SMTP: port 587 was unreliable from Render (auth/connection
# failures that never showed up in local dev). The API goes over normal
# HTTPS instead, same as every other outbound call this app makes.
# Once you have a real domain:
#   1. Brevo dashboard -> Settings -> Senders, Domains & Dedicated IPs -> add
#      + verify your domain (SPF/DKIM records) so mail doesn't land in spam.
#   2. Brevo dashboard -> Settings -> SMTP & API -> "API Keys" tab (NOT the
#      "SMTP" tab — that's a different key, for SMTP, not this) -> create a key.
#      BREVO_API_KEY = that key (starts with xkeysib-).
#   3. DEFAULT_FROM_EMAIL below must be an address on the verified domain from step 1.
#   4. Flip EMAIL_BACKEND to the Brevo API line below (it's on console/no-op until then).
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
# EMAIL_BACKEND=apps.core.email_backend.BrevoAPIEmailBackend
BREVO_API_KEY=
DEFAULT_FROM_EMAIL=Code Secure Academy <info@codesecureacademy.com>

# --- Old SMTP config, kept in case you'd rather use SMTP (Brevo, Zoho Mail,
# Google Workspace, etc. all work) — unused while EMAIL_BACKEND is the Brevo
# API class above. ---
EMAIL_HOST=smtp-relay.brevo.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=

# --- Cloudinary (free plan) ---
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# --- Paystack ---
PAYSTACK_PUBLIC_KEY=pk_test_xxxxxxxx
PAYSTACK_SECRET_KEY=sk_test_xxxxxxxx

# --- Google OAuth (for "Sign in with Google") ---
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# --- Seat-hold behaviour ---
SEAT_HOLD_MINUTES=5
SEAT_HOLD_GRACE_MINUTES=3
# Long random token — the external pinger (cron-job.org/UptimeRobot) must send this
# to authenticate calls to /internal/release-expired-holds/
INTERNAL_TASK_TOKEN=change-me-to-a-long-random-string

# --- Marketplace ---
MARKETPLACE_CSA_SPLIT_PERCENT=10

# --- Courses (tutor payouts) ---
COURSE_TUTOR_PAYOUT_PERCENT=90
# Hours a payout waits before /pay/internal/release-pending-payouts/ auto-releases it —
# same external-pinger pattern as INTERNAL_TASK_TOKEN above
PAYOUT_HOLD_HOURS=48

# --- Social ---
INSTAGRAM_URL=https://www.instagram.com/codesecuracademy?igsh=amRhZ2VsNDN3MmF2
FACEBOOK_URL=https://www.facebook.com/share/1DVbyQE8Bo/
WHATSAPP_CONTACT_NUMBER=2348158983927
